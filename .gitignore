# 依赖
node_modules/

# 敏感：账号登录态（cookies/session），泄露即账号被盗
profiles/

# 敏感：含真实邮箱、代理等
config/accounts.json
config/settings.json

# 敏感：代理节点含服务器地址与密码，泄露即节点被盗用
config/proxies.json

# 账号分组（个人运行时数据）
config/groups.json

# 代理边车运行时目录（自动生成的 mihomo 配置与缓存）
.mihomo/

# 个人会话内容（运行时数据，用 .example 做模板）
config/conversations.json

# 对话历史与运行日志
logs/

# 系统与编辑器
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
