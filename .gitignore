# 依赖
node_modules/

# Native desktop build / packaging output
desktop/**/bin/
desktop/**/obj/
desktop/**/TestResults/
tools/**/bin/
tools/**/obj/
artifacts/
Releases/
*.AppImage

# Local SQLite runtime files (fixtures under test/fixtures stay explicit)
keeper.db
keeper.db-wal
keeper.db-shm

# 敏感：账号登录态（cookies/session），泄露即账号被盗
profiles/

# 敏感：已归档账号的完整浏览器登录态
profiles-archive/

# Profile 彻底删除过程中的同盘暂存目录
.profile-trash/

# 敏感：含真实邮箱、代理等
config/accounts.json
config/settings.json

# 登录状态巡检缓存（含账号邮箱及最近确认状态）
config/status-cache.json
config/.status-cache.json.*.tmp

# 敏感：代理节点含服务器地址与密码，泄露即节点被盗用
config/proxies.json

# 账号分组（个人运行时数据）
config/groups.json

# 代理边车运行时目录（自动生成的 mihomo 配置与缓存）
.mihomo/
.mihomo-test/
mihomo/
mihomo-test/

# 个人会话内容（运行时数据，用 .example 做模板）
config/conversations.json

# 对话历史与运行日志
logs/

# 系统与编辑器
.DS_Store
Thumbs.db
.vscode/
.idea/
.vs/
*.log
