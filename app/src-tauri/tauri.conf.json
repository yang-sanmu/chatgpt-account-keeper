{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatGPT Account Keeper",
  "version": "0.2.0",
  "identifier": "io.github.yang-sanmu.gptaccountkeeper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ChatGPT Account Keeper",
        "width": 1260,
        "height": 820,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "visible": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb", "rpm"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 yang-sanmu",
    "category": "Utility",
    "shortDescription": "ChatGPT 多账号会话管理",
    "longDescription": "ChatGPT 多账号的原生桌面管理与后台自动对话工具。每个账号使用独立的 Google Chrome Profile。",
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../LICENSE": "licenses/LICENSE",
      "../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../../PRIVACY.md": "licenses/PRIVACY.md",
      "../../SOURCE.md": "licenses/SOURCE.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "libayatana-appindicator-gtk3"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFMjgzQUY2NzhBNTRGMzIKUldReVQ2VjQ5am9vSGkxUWJIUm1JVi9wU201MjFiZ2lBSk5lVUF1azZBTVp2WkswcE9rcTdUZEkK",
      "endpoints": [
        "https://github.com/yang-sanmu/chatgpt-account-keeper/releases/latest/download/latest.json"
      ]
    }
  }
}
