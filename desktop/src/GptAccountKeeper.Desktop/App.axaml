<Application
    x:Class="GptAccountKeeper.Desktop.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://GptAccountKeeper.Desktop/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- ==========================================
           Modern Slate Neo-Glass Design System Tokens
           ========================================== -->
      <Color x:Key="ColorBgDark">#0B0F19</Color>
      <Color x:Key="ColorBgSidebar">#080C14</Color>
      <Color x:Key="ColorBgCard">#111927</Color>
      <Color x:Key="ColorBgCardHover">#162235</Color>
      <Color x:Key="ColorBgElevated">#1E293B</Color>
      <Color x:Key="ColorBgInput">#0A101D</Color>
      <Color x:Key="ColorBgInputFocus">#0D1527</Color>

      <Color x:Key="ColorBorder">#1E2D4A</Color>
      <Color x:Key="ColorBorderSubtle">#172238</Color>
      <Color x:Key="ColorBorderHover">#2E436E</Color>
      <Color x:Key="ColorBorderHighlight">#3B82F6</Color>

      <!-- Semantic Accents -->
      <Color x:Key="ColorPrimary">#3B82F6</Color>
      <Color x:Key="ColorPrimaryHover">#2563EB</Color>
      <Color x:Key="ColorPrimaryActive">#1D4ED8</Color>
      <Color x:Key="ColorSuccess">#10B981</Color>
      <Color x:Key="ColorSuccessHover">#059669</Color>
      <Color x:Key="ColorWarning">#F59E0B</Color>
      <Color x:Key="ColorWarningHover">#D97706</Color>
      <Color x:Key="ColorDanger">#EF4444</Color>
      <Color x:Key="ColorDangerHover">#DC2626</Color>
      <Color x:Key="ColorInfo">#38BDF8</Color>
      <Color x:Key="ColorPurple">#8B5CF6</Color>
      <Color x:Key="ColorIndigo">#6366F1</Color>

      <!-- Typography Colors -->
      <Color x:Key="ColorTextPrimary">#F8FAFC</Color>
      <Color x:Key="ColorTextSecondary">#94A3B8</Color>
      <Color x:Key="ColorTextMuted">#64748B</Color>
      <Color x:Key="ColorTextFaint">#475569</Color>

      <!-- Solid Brushes -->
      <SolidColorBrush x:Key="BrushBgDark" Color="{StaticResource ColorBgDark}" />
      <SolidColorBrush x:Key="BrushBgSidebar" Color="{StaticResource ColorBgSidebar}" />
      <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource ColorBgCard}" />
      <SolidColorBrush x:Key="BrushBgCardHover" Color="{StaticResource ColorBgCardHover}" />
      <SolidColorBrush x:Key="BrushBgElevated" Color="{StaticResource ColorBgElevated}" />
      <SolidColorBrush x:Key="BrushBgInput" Color="{StaticResource ColorBgInput}" />
      <SolidColorBrush x:Key="BrushBgInputFocus" Color="{StaticResource ColorBgInputFocus}" />

      <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
      <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource ColorBorderSubtle}" />
      <SolidColorBrush x:Key="BrushBorderHover" Color="{StaticResource ColorBorderHover}" />
      <SolidColorBrush x:Key="BrushBorderHighlight" Color="{StaticResource ColorBorderHighlight}" />

      <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" />
      <SolidColorBrush x:Key="BrushPrimaryHover" Color="{StaticResource ColorPrimaryHover}" />
      <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
      <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
      <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
      <SolidColorBrush x:Key="BrushInfo" Color="{StaticResource ColorInfo}" />
      <SolidColorBrush x:Key="BrushPurple" Color="{StaticResource ColorPurple}" />
      <SolidColorBrush x:Key="BrushIndigo" Color="{StaticResource ColorIndigo}" />

      <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
      <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
      <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />
      <SolidColorBrush x:Key="BrushTextFaint" Color="{StaticResource ColorTextFaint}" />

      <!-- Gradients -->
      <LinearGradientBrush x:Key="BrushPrimaryGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#3B82F6" />
        <GradientStop Offset="1" Color="#6366F1" />
      </LinearGradientBrush>

      <LinearGradientBrush x:Key="BrushPrimaryGradientHover" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#2563EB" />
        <GradientStop Offset="1" Color="#4F46E5" />
      </LinearGradientBrush>

      <LinearGradientBrush x:Key="BrushSuccessGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#10B981" />
        <GradientStop Offset="1" Color="#059669" />
      </LinearGradientBrush>

      <LinearGradientBrush x:Key="BrushPurpleGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#8B5CF6" />
        <GradientStop Offset="1" Color="#6366F1" />
      </LinearGradientBrush>

      <LinearGradientBrush x:Key="BrushDangerGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#EF4444" />
        <GradientStop Offset="1" Color="#DC2626" />
      </LinearGradientBrush>

      <LinearGradientBrush x:Key="BrushSidebarGradient" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#0B101B" />
        <GradientStop Offset="1" Color="#070A12" />
      </LinearGradientBrush>

      <LinearGradientBrush x:Key="BrushHeaderGradient" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#101826" />
        <GradientStop Offset="1" Color="#0B0F19" />
      </LinearGradientBrush>

      <LinearGradientBrush x:Key="BrushCardGlowGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#1E293B" />
        <GradientStop Offset="0.5" Color="#131C2E" />
        <GradientStop Offset="1" Color="#0E1626" />
      </LinearGradientBrush>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Window & Global Typography -->
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter, Microsoft YaHei, Segoe UI, sans-serif" />
      <Setter Property="Background" Value="{StaticResource BrushBgDark}" />
      <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Base Card Styles -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource BrushBgCard}" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BoxShadow" Value="0 4 16 0 #28000000" />
    </Style>

    <Style Selector="Border.subtle-card">
      <Setter Property="Background" Value="#0D1424" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="Border.stat-card">
      <Setter Property="Background" Value="{StaticResource BrushBgCard}" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BoxShadow" Value="0 6 20 0 #33000000" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
          <BrushTransition Property="Background" Duration="0:0:0.18" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.stat-card:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource BrushBorderHover}" />
      <Setter Property="Background" Value="{StaticResource BrushBgCardHover}" />
    </Style>

    <Style Selector="Border.glass-card">
      <Setter Property="Background" Value="#0F172ACC" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- Pill Badge / Tag -->
    <Style Selector="Border.pill">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Background" Value="#172554" />
      <Setter Property="BorderBrush" Value="#1D4ED8" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.pill-neutral">
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Background" Value="#1E293B" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Button Default -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="{StaticResource BrushBgElevated}" />
      <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushBgCardHover}" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushBorderHover}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#152033" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- Button Primary Variant -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource BrushPrimaryGradient}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushPrimaryGradientHover}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1D4ED8" />
    </Style>

    <!-- Button Danger Variant -->
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#2E1117" />
      <Setter Property="Foreground" Value="#FCA5A5" />
      <Setter Property="BorderBrush" Value="#7F1D1D" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#7F1D1D" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#991B1B" />
    </Style>

    <!-- Button Warning Variant -->
    <Style Selector="Button.warn">
      <Setter Property="Background" Value="#31200D" />
      <Setter Property="Foreground" Value="#FCD34D" />
      <Setter Property="BorderBrush" Value="#78350F" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.warn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#78350F" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#92400E" />
    </Style>

    <!-- Button Ghost Variant -->
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1E293B" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Button Subtle / Compact Action Variant -->
    <Style Selector="Button.subtle">
      <Setter Property="Background" Value="#0F172A" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
      <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushBgElevated}" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushBorderHover}" />
      <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <!-- Button Icon Only Variant -->
    <Style Selector="Button.icon-btn">
      <Setter Property="Padding" Value="6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    </Style>
    <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrushBgElevated}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- TextBox -->
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{StaticResource BrushBgInput}" />
      <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="SelectionBrush" Value="{StaticResource BrushPrimary}" />
      <Setter Property="CaretBrush" Value="{StaticResource BrushPrimary}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
      <Setter Property="Background" Value="{StaticResource BrushBgInputFocus}" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource BrushBorderHover}" />
    </Style>

    <!-- ComboBox -->
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{StaticResource BrushBgInput}" />
      <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{StaticResource BrushBorderHover}" />
    </Style>
    <Style Selector="ComboBox:focus /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="4,2" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#172554" />
      <Setter Property="Foreground" Value="#93C5FD" />
    </Style>

    <!-- NumericUpDown -->
    <Style Selector="NumericUpDown">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{StaticResource BrushBgInput}" />
      <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="NumericUpDown:focus /template/ TextBox#PART_TextBox">
      <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
    </Style>

    <!-- ListBox -->
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#172554" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#121D30" />
    </Style>

    <!-- ProgressBar -->
    <Style Selector="ProgressBar">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="#1E293B" />
      <Setter Property="Foreground" Value="{StaticResource BrushPrimaryGradient}" />
    </Style>

    <!-- CheckBox -->
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ToggleSwitch -->
    <Style Selector="ToggleSwitch">
      <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ToolTip Styling -->
    <Style Selector="ToolTip">
      <Setter Property="Background" Value="#0F172A" />
      <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <!-- ScrollBar Slim Modern Design -->
    <Style Selector="ScrollBar">
      <Setter Property="AllowAutoHide" Value="True" />
    </Style>

    <!-- Stroke-based vector icon style. The shared geometries use Lucide-style
         center lines, so they must be stroked instead of filled by PathIcon. -->
    <Style Selector="Path.vector-icon">
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </Application.Styles>
</Application>
