<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>GptAccountKeeper.Desktop</AssemblyName>
    <RootNamespace>GptAccountKeeper.Desktop</RootNamespace>
    <ApplicationTitle>ChatGPT Account Keeper</ApplicationTitle>
    <ApplicationId>io.github.yang-sanmu.gptaccountkeeper</ApplicationId>
    <BundleIdentifier>io.github.yang-sanmu.gptaccountkeeper</BundleIdentifier>
    <Product>ChatGPT Account Keeper</Product>
    <Authors>yang-sanmu</Authors>
    <Copyright>Copyright © 2026 yang-sanmu</Copyright>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/yang-sanmu/chatgpt-account-keeper</RepositoryUrl>
    <Version>0.1.12</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>false</InvariantGlobalization>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Win32 icon resource on the exe. Without it Explorer, the Start menu and
         the VeloPack shortcuts all fall back to the generic executable icon. -->
    <ApplicationIcon>app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Not copied verbatim: CFBundleShortVersionString is stamped from $(Version)
         by the StampInfoPlist target below, so the template's placeholder version
         can never ship in a macOS bundle. -->
    <None Include="Info.plist" CopyToOutputDirectory="Never" />
    <None Include="..\..\..\LICENSE" Link="licenses\LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\..\THIRD_PARTY_NOTICES.md" Link="licenses\THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\..\PRIVACY.md" Link="licenses\PRIVACY.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\..\SOURCE.md" Link="licenses\SOURCE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Info.plist ships inside the macOS .app bundle, so its version has to match
       the build. Copying the template verbatim silently shipped a stale
       CFBundleShortVersionString; regenerate it from $(Version) instead. -->
  <!-- This target intentionally runs after every build. $(Version) may be
       supplied on the command line, so file-only Inputs/Outputs tracking would
       incorrectly reuse a plist stamped by an earlier build. The write itself
       is cheap and WriteOnlyWhenDifferent avoids touching an unchanged file. -->
  <Target Name="StampInfoPlist" AfterTargets="Build">
    <PropertyGroup>
      <!-- Apple bundle version fields accept numeric dot-separated components,
           not SemVer prerelease suffixes. VeloPack still receives the complete
           package version; only Info.plist uses its numeric core. -->
      <_AppleBundleVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(Version)', '-.*$', ''))</_AppleBundleVersion>
      <_PlistTemplate>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)Info.plist'))</_PlistTemplate>
      <_PlistStamped>$(_PlistTemplate.Replace('&lt;string&gt;0.0.0-template&lt;/string&gt;', '&lt;string&gt;$(_AppleBundleVersion)&lt;/string&gt;').Replace('&lt;string&gt;0.0.0-build-template&lt;/string&gt;', '&lt;string&gt;$(_AppleBundleVersion)&lt;/string&gt;'))</_PlistStamped>
    </PropertyGroup>
    <WriteLinesToFile File="$(OutDir)Info.plist" Lines="$(_PlistStamped)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="PublishInfoPlist" AfterTargets="Publish">
    <Copy SourceFiles="$(OutDir)Info.plist" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
