<Window
    x:Class="GptAccountKeeper.Desktop.Presentation.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GptAccountKeeper.Desktop.Presentation"
    xmlns:pages="using:GptAccountKeeper.Desktop.Presentation.Pages"
    xmlns:views="using:GptAccountKeeper.Desktop.Presentation.Views"
    x:DataType="vm:ShellViewModel"
    Title="ChatGPT Account Keeper"
    Width="1420"
    Height="900"
    MinWidth="1180"
    MinHeight="750"
    Background="{DynamicResource BrushBgDark}"
    WindowStartupLocation="CenterScreen">

  <Grid ColumnDefinitions="260,*">
    <!-- 侧边导航栏 -->
    <Border Grid.Column="0" Background="{DynamicResource BrushSidebarGradient}"
            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="16,20,16,16">

        <!-- 品牌标识 Header -->
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="40,*" ColumnSpacing="12" VerticalAlignment="Center">
            <!-- Logo 图标容器 -->
            <Border Width="40" Height="40" CornerRadius="12"
                    Background="{StaticResource BrushPrimaryGradient}"
                    BoxShadow="0 4 12 0 #403B82F6">
              <Path Data="{StaticResource IconZap}" Width="20" Height="20"
                    Classes="vector-icon" Stroke="#FFFFFF" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="ChatGPT" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                <TextBlock Text="Keeper" FontSize="16" FontWeight="Light" Foreground="{DynamicResource BrushPrimary}" />
              </StackPanel>
              <Border HorizontalAlignment="Left" Padding="6,2" CornerRadius="6"
                      Background="{DynamicResource BrushBadgeBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
                <TextBlock Text="{Binding DesktopVersion}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimary}" />
              </Border>
            </StackPanel>
          </Grid>
          <Rectangle Height="1" Fill="{DynamicResource BrushBorderSubtle}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 页面导航列表 (ListBox) -->
        <ListBox Grid.Row="1"
                 Margin="0,14,0,12"
                 Background="Transparent"
                 BorderThickness="0"
                 ItemsSource="{Binding Pages}"
                 SelectedItem="{Binding SelectedPage, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PageViewModel">
              <Grid ColumnDefinitions="32,*" Margin="4,4">
                <!-- 图标外框 -->
                <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource BrushBadgeBg}"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Glyph}" FontSize="13" Foreground="{DynamicResource BrushPrimary}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <!-- 标题与简介 -->
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="6,0,0,0">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" />
                  <TextBlock Text="{Binding Description}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- 底部 IPC 守护进程卡片 -->
        <Border Grid.Row="2" Padding="14,12" CornerRadius="10"
                Background="{DynamicResource BrushCardInner}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                BoxShadow="0 4 12 0 #20000000">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="{Binding AgentConnectionStatusColor}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Overview.ConnectionStatus}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
              </StackPanel>
              <Border Grid.Column="1" Padding="5,2" CornerRadius="4" Background="{DynamicResource BrushBadgeBg}">
                <TextBlock Text="{Binding RuntimeMode}" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource BrushInfo}" />
              </Border>
            </Grid>
            <Border Padding="6,4" CornerRadius="6" Background="{DynamicResource BrushSubtleBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
              <TextBlock Text="{Binding Endpoint}" FontSize="9" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextMuted}" FontFamily="Consolas, monospace" />
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- 主工作区 -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">

      <!-- 全局顶栏 Header -->
      <Border Margin="24,18,24,14" Padding="0,0,0,14" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <!-- 页面标题与描述 -->
          <StackPanel Spacing="3" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{Binding SelectedPage.Glyph}" FontSize="20" VerticalAlignment="Center" Foreground="{DynamicResource BrushPrimary}" />
              <TextBlock Text="{Binding SelectedPage.Title}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding SelectedPage.Description}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="28,0,0,0" />
          </StackPanel>

          <!-- 顶部全局动作工具栏 -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">

            <!-- 全局调度器微光胶囊 -->
            <Border Padding="12,6" CornerRadius="20"
                    Background="{DynamicResource BrushSubtleBg}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="{Binding SchedulerStatusColor}" VerticalAlignment="Center" />
                <TextBlock Text="调度器:" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SchedulerStatusText}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{Binding SchedulerStatusColor}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>

            <!-- 启停调度器快捷按钮 -->
            <Button Content="{Binding SchedulerActionText}"
                    Classes="primary"
                    Command="{Binding ToggleSchedulerCommand}"
                    ToolTip.Tip="全局调度器开关：开启后按设定间隔自动唤醒并轮换对话" />

            <Rectangle Width="1" Height="22" Fill="{DynamicResource BrushBorder}" Margin="4,0" />

            <!-- 数据同步忙状态指示条 -->
            <ProgressBar Width="70" Height="4" IsIndeterminate="True"
                         IsVisible="{Binding Session.IsBusy}" VerticalAlignment="Center" />

            <Button Content="重新连接" Command="{Binding ConnectAgentCommand}"
                    IsVisible="{Binding !IsAgentConnected}" />

            <Button Content="🔄 同步数据" Command="{Binding RefreshDataCommand}"
                    ToolTip.Tip="重新从 Agent 拉取最新账号与状态数据" />

            <Button Content="{Binding AgentActionText}"
                    Classes="primary"
                    Command="{Binding StartAgentCommand}"
                    ToolTip.Tip="已连接时无需重复启动；断开后按钮会自动恢复" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- 页面内容容器 -->
      <Panel Grid.Row="1">
        <ContentControl Content="{Binding SelectedPage}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="pages:OverviewPageViewModel">
              <views:OverviewPage />
            </DataTemplate>
            <DataTemplate DataType="pages:AccountsPageViewModel">
              <views:AccountsPage />
            </DataTemplate>
            <DataTemplate DataType="pages:OperationsPageViewModel">
              <views:OperationsPage />
            </DataTemplate>
            <DataTemplate DataType="pages:ProxiesPageViewModel">
              <views:ProxiesPage />
            </DataTemplate>
            <DataTemplate DataType="pages:ConversationsPageViewModel">
              <views:ConversationsPage />
            </DataTemplate>
            <DataTemplate DataType="pages:ProfilesPageViewModel">
              <views:ProfilesPage />
            </DataTemplate>
            <DataTemplate DataType="pages:HistoryPageViewModel">
              <views:HistoryPage />
            </DataTemplate>
            <DataTemplate DataType="pages:SettingsPageViewModel">
              <views:SettingsPage />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>

        <!-- 浮层 Toast 通知 (右上角悬浮) -->
        <ItemsControl ItemsSource="{Binding Toasts.Items}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,8,26,0"
                      Width="440"
                      IsHitTestVisible="True">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ToastViewModel">
              <Border Margin="0,0,0,8" Padding="14,10" CornerRadius="10"
                      Background="{Binding Background}"
                      BorderBrush="{Binding BorderColor}"
                      BorderThickness="1"
                      BoxShadow="0 6 20 0 #50000000">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Text="{Binding Glyph}" FontWeight="Bold" FontSize="14" Margin="0,0,10,0"
                             Foreground="{Binding Foreground}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"
                             FontSize="12" Foreground="{Binding Foreground}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Panel>
    </Grid>
  </Grid>
</Window>
