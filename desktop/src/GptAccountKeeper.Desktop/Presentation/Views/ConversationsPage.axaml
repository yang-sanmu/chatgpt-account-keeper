<UserControl
    x:Class="GptAccountKeeper.Desktop.Presentation.Views.ConversationsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GptAccountKeeper.Desktop.Models"
    xmlns:pages="using:GptAccountKeeper.Desktop.Presentation.Pages"
    x:DataType="pages:ConversationsPageViewModel">

  <Grid Margin="26,0,26,20" ColumnDefinitions="1*,1.1*" ColumnSpacing="14">

    <Border CornerRadius="10" Background="White" BorderBrush="#EAECF0" BorderThickness="1">
      <Grid Margin="14" RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,9">
          <StackPanel>
            <TextBlock Text="会话主题" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#667085" />
          </StackPanel>
          <Button Grid.Column="1" Content="新建会话集" Padding="9,5" FontSize="11"
                  Command="{Binding BeginNewCommand}" />
        </Grid>

        <Panel Grid.Row="1">
          <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:ConversationSetDto">
                <StackPanel Margin="4,6" Spacing="3">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="{Binding RoundsText}" FontSize="10" Foreground="#667085" />
                  </Grid>
                  <TextBlock Text="{Binding Topic}" FontSize="11" Foreground="#475467"
                             TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Spacing="8" MaxWidth="300">
            <TextBlock Text="✎" FontSize="32" Foreground="#D0D5DD" HorizontalAlignment="Center" />
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Foreground="#667085"
                       Text="还没有会话主题。Agent 会围绕主题自动开启对话并逐轮追问，至少需要一个主题才能运行。" />
          </StackPanel>
        </Panel>
      </Grid>
    </Border>

    <Border Grid.Column="1" CornerRadius="10" Background="White" BorderBrush="#EAECF0" BorderThickness="1">
      <ScrollViewer Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding FormTitle}" FontSize="15" FontWeight="SemiBold" />
          <TextBox PlaceholderText="会话集名称（例如：C# 架构设计）"
                   Text="{Binding Name, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
          <TextBlock Text="对话主题" FontSize="10" Foreground="#667085" />
          <TextBox AcceptsReturn="True" MinHeight="200" TextWrapping="Wrap"
                   PlaceholderText="描述希望 Agent 展开讨论的主题，Agent 会据此提问并逐轮追问"
                   Text="{Binding Topic, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <StackPanel Spacing="3">
              <TextBlock Text="最少轮数" FontSize="10" Foreground="#667085" />
              <NumericUpDown Minimum="1" Maximum="100" Increment="1" FormatString="0"
                             Value="{Binding MinRounds, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock Text="最多轮数" FontSize="10" Foreground="#667085" />
              <NumericUpDown Minimum="1" Maximum="100" Increment="1" FormatString="0"
                             Value="{Binding MaxRounds, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding ValidationError}" FontSize="11" Foreground="#B42318" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding SaveText}" Background="#175CD3" Foreground="White"
                    IsEnabled="{Binding CanEdit}" Command="{Binding SaveCommand}" />
            <Button Content="删除会话集…" Foreground="#B42318" Command="{Binding RemoveCommand}" />
          </StackPanel>
          <Border Padding="11" Background="#FFFAEB" CornerRadius="7">
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#7A2E0E"
                       Text="重命名会先创建新名称再删除旧名称。如果中途失败，可能同时留下两份，需要手动删除多余的一份；保存前会再次确认。" />
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
