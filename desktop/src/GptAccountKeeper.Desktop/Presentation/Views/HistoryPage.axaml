<UserControl
    x:Class="GptAccountKeeper.Desktop.Presentation.Views.HistoryPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GptAccountKeeper.Desktop.Models"
    xmlns:pages="using:GptAccountKeeper.Desktop.Presentation.Pages"
    x:DataType="pages:HistoryPageViewModel">

  <Grid Margin="26,0,26,20" ColumnDefinitions="270,340,*" ColumnSpacing="14">

    <Border CornerRadius="10" Background="White" BorderBrush="#EAECF0" BorderThickness="1">
      <Grid Margin="14" RowDefinitions="Auto,*">
        <StackPanel Margin="0,0,0,9" Spacing="2">
          <TextBlock Text="历史账号" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="已删除的账号仍会列出" FontSize="11" Foreground="#667085" />
        </StackPanel>
        <Panel Grid.Row="1">
          <ListBox ItemsSource="{Binding Accounts}"
                   SelectedItem="{Binding SelectedAccount, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:HistoryAccountDto">
                <StackPanel Margin="4,6" Spacing="2">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="#667085" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel IsVisible="{Binding !HasHistoryAccounts}" VerticalAlignment="Center"
                      HorizontalAlignment="Center" Spacing="7" MaxWidth="220">
            <TextBlock Text="◷" FontSize="30" Foreground="#D0D5DD" HorizontalAlignment="Center" />
            <TextBlock Text="还没有运行历史。账号完成一次自动对话后会出现在这里。"
                       TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Foreground="#667085" />
          </StackPanel>
        </Panel>
      </Grid>
    </Border>

    <Border Grid.Column="1" CornerRadius="10" Background="White" BorderBrush="#EAECF0" BorderThickness="1">
      <Grid Margin="14" RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#475467"
                     TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="重新载入" Padding="9,5" FontSize="11"
                  Command="{Binding ReloadCommand}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,120" ColumnSpacing="8" Margin="0,0,0,9">
          <TextBox PlaceholderText="搜索问答内容或错误" Text="{Binding Search, Mode=TwoWay}" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding ResultFilters}"
                    SelectedItem="{Binding ResultFilter, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="pages:HistoryResultFilterOption">
                <TextBlock Text="{Binding Title}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <Panel Grid.Row="2">
          <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:HistoryEntryDto">
                <StackPanel Margin="4,6" Spacing="2">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="#475467" />
                    <TextBlock Grid.Column="1" Text="{Binding ResultText}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{Binding ResultColor}" />
                  </Grid>
                  <TextBlock Text="{Binding SummaryText}" FontSize="10" Foreground="#667085"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Spacing="8" MaxWidth="260">
            <TextBlock Text="◷" FontSize="30" Foreground="#D0D5DD" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" TextAlignment="Center"
                       FontSize="12" Foreground="#667085" />
          </StackPanel>
        </Panel>
      </Grid>
    </Border>

    <!-- 问答详情：恢复旧面板的 Q&A 气泡与复制 -->
    <Border Grid.Column="2" CornerRadius="10" Background="White" BorderBrush="#EAECF0" BorderThickness="1">
      <Grid Margin="14" RowDefinitions="Auto,*" IsVisible="{Binding HasSelectedEntry}">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding SelectedEntry.SummaryText}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SelectedEntry.TimeText}" FontSize="11" Foreground="#667085" />
          </StackPanel>
          <Button Grid.Column="1" Content="复制全部问答" Padding="9,5" FontSize="11"
                  Command="{Binding CopyAnswerCommand}" />
        </Grid>

        <ScrollViewer Grid.Row="1">
          <StackPanel Spacing="10">
            <Border IsVisible="{Binding SelectedEntry.HasError}" Padding="11" CornerRadius="8"
                    Background="#FEF3F2" BorderBrush="#FECDCA" BorderThickness="1">
              <StackPanel Spacing="4">
                <TextBlock Text="本次运行失败" FontSize="12" FontWeight="SemiBold" Foreground="#B42318" />
                <SelectableTextBlock Text="{Binding SelectedEntry.Error}" FontSize="12" TextWrapping="Wrap"
                                     Foreground="#7A271A" />
              </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding SelectedEntry.Rounds}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:HistoryRoundDto">
                  <StackPanel Margin="0,0,0,12" Spacing="6">
                    <Border Padding="11" CornerRadius="8" Background="#EFF8FF"
                            HorizontalAlignment="Left" MaxWidth="640">
                      <StackPanel Spacing="3">
                        <TextBlock Text="提问" FontSize="10" FontWeight="SemiBold" Foreground="#175CD3" />
                        <SelectableTextBlock Text="{Binding QuestionText}" FontSize="12" TextWrapping="Wrap"
                                             Foreground="#194185" />
                      </StackPanel>
                    </Border>
                    <Border Padding="11" CornerRadius="8" Background="#F9FAFB"
                            BorderBrush="#EAECF0" BorderThickness="1" MaxWidth="720">
                      <StackPanel Spacing="3">
                        <TextBlock Text="回答" FontSize="10" FontWeight="SemiBold" Foreground="#475467" />
                        <SelectableTextBlock Text="{Binding AnswerText}" FontSize="12" TextWrapping="Wrap"
                                             Foreground="#344054" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock IsVisible="{Binding !SelectedEntry.HasRounds}" FontSize="12" Foreground="#667085"
                       TextWrapping="Wrap"
                       Text="这条记录没有保存问答内容（通常是运行在开始对话前就失败了）。" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
