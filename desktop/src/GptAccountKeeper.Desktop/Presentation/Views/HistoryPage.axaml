<UserControl
    x:Class="GptAccountKeeper.Desktop.Presentation.Views.HistoryPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GptAccountKeeper.Desktop.Models"
    xmlns:pages="using:GptAccountKeeper.Desktop.Presentation.Pages"
    x:DataType="pages:HistoryPageViewModel">

  <Grid Margin="24,0,24,20" ColumnDefinitions="230,300,*" ColumnSpacing="16">

    <!-- 第一栏：历史账号选择列表 -->
    <Border Classes="card" Padding="16">
      <Grid RowDefinitions="Auto,*">
        <StackPanel Margin="0,0,0,12" Spacing="2">
          <TextBlock Text="历史账号" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" />
          <TextBlock Text="含已归档/删除账号的运行记录" FontSize="10" Foreground="#64748B" />
        </StackPanel>

        <Panel Grid.Row="1">
          <ListBox ItemsSource="{Binding Accounts}"
                   SelectedItem="{Binding SelectedAccount, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:HistoryAccountDto">
                <Border Margin="0,2" Padding="12,10" CornerRadius="8" Background="#0F172A" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="#F8FAFC"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="#94A3B8" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- 空状态 -->
          <StackPanel IsVisible="{Binding !HasHistoryAccounts}" VerticalAlignment="Center"
                      HorizontalAlignment="Center" Spacing="10" MaxWidth="200">
            <Border Width="56" Height="56" CornerRadius="28" Background="#1E293B" HorizontalAlignment="Center">
              <Path Data="{StaticResource IconHistory}" Width="24" Height="24" Classes="vector-icon" Stroke="#60A5FA" />
            </Border>
            <TextBlock Text="暂无运行历史" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
            <TextBlock Text="账号完成一次自动对话后会出现在这里。"
                       TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Foreground="#94A3B8" LineHeight="16" />
          </StackPanel>
        </Panel>
      </Grid>
    </Border>

    <!-- 第二栏：运行记录列表 -->
    <Border Grid.Column="1" Classes="card" Padding="16">
      <Grid RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
          <TextBlock Text="{Binding Summary}" FontSize="11" FontWeight="Medium" Foreground="#93C5FD"
                     TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="🔄 刷新" Padding="9,4" FontSize="11"
                  Command="{Binding ReloadCommand}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,115" ColumnSpacing="10" Margin="0,0,0,12">
          <TextBox PlaceholderText="🔍 搜索内容或错误…" Text="{Binding Search, Mode=TwoWay}" />
          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding ResultFilters}"
                    SelectedItem="{Binding ResultFilter, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="pages:HistoryResultFilterOption">
                <TextBlock Text="{Binding Title}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <Panel Grid.Row="2">
          <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:HistoryEntryDto">
                <Border Margin="0,2" Padding="12,10" CornerRadius="8" Background="#0F172A" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="#94A3B8" />
                      <Border Grid.Column="1" Padding="6,2" CornerRadius="4" Background="#1E293B">
                        <TextBlock Text="{Binding ResultText}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{Binding ResultColor}" />
                      </Border>
                    </Grid>
                    <TextBlock Text="{Binding SummaryText}" FontSize="11" Foreground="#CBD5E1"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- 空记录 -->
          <StackPanel IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Spacing="10" MaxWidth="240">
            <Border Width="56" Height="56" CornerRadius="28" Background="#1E293B" HorizontalAlignment="Center">
              <Path Data="{StaticResource IconMessageSquare}" Width="24" Height="24" Classes="vector-icon" Stroke="#818CF8" />
            </Border>
            <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" TextAlignment="Center"
                       FontSize="11" Foreground="#94A3B8" LineHeight="16" />
          </StackPanel>
        </Panel>
      </Grid>
    </Border>

    <!-- 第三栏：问答对话流 (Chat Stream) -->
    <Border Grid.Column="2" Classes="card" Padding="20">
      <Grid RowDefinitions="Auto,*" IsVisible="{Binding HasSelectedEntry}">

        <!-- 对话头部 -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding SelectedEntry.SummaryText}" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" />
            <TextBlock Text="{Binding SelectedEntry.TimeText}" FontSize="11" Foreground="#64748B" />
          </StackPanel>
          <Button Grid.Column="1" Content="📋 复制全部问答" Classes="primary" Padding="12,6" FontSize="11"
                  Command="{Binding CopyAnswerCommand}" />
        </Grid>

        <!-- 对话内容滚动流 -->
        <ScrollViewer Grid.Row="1">
          <StackPanel Spacing="16">

            <!-- 失败错误提示面板 -->
            <Border IsVisible="{Binding SelectedEntry.HasError}" Padding="14" CornerRadius="8"
                    Background="#381014" BorderBrush="#DC2626" BorderThickness="1">
              <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="{StaticResource IconAlertTriangle}" Width="16" Height="16" Classes="vector-icon" Stroke="#F87171" />
                  <TextBlock Text="本次运行未成功完成" FontSize="12" FontWeight="Bold" Foreground="#FCA5A5" />
                </StackPanel>
                <SelectableTextBlock Text="{Binding SelectedEntry.Error}" FontSize="11" TextWrapping="Wrap"
                                     Foreground="#FECACA" LineHeight="17" />
              </StackPanel>
            </Border>

            <!-- 多轮 Q&A 问答气泡流 -->
            <ItemsControl ItemsSource="{Binding SelectedEntry.Rounds}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:HistoryRoundDto">
                  <StackPanel Margin="0,0,0,18" Spacing="10">

                    <!-- 用户提问气泡 (蓝色微光卡片) -->
                    <Border Padding="14,12" CornerRadius="10" Background="#172554"
                            BorderBrush="#1D4ED8" BorderThickness="1"
                            HorizontalAlignment="Left" MaxWidth="700">
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Path Data="{StaticResource IconUser}" Width="14" Height="14" Classes="vector-icon" Stroke="#93C5FD" />
                          <TextBlock Text="提问 (User)" FontSize="10" FontWeight="Bold" Foreground="#93C5FD" />
                        </StackPanel>
                        <SelectableTextBlock Text="{Binding QuestionText}" FontSize="12" TextWrapping="Wrap"
                                             Foreground="#F8FAFC" LineHeight="18" />
                      </StackPanel>
                    </Border>

                    <!-- ChatGPT 回答气泡 (深蓝灰卡片) -->
                    <Border Padding="16,14" CornerRadius="10" Background="#0F172A"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" MaxWidth="780">
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Path Data="{StaticResource IconBot}" Width="14" Height="14" Classes="vector-icon" Stroke="#10B981" />
                          <TextBlock Text="ChatGPT 回复" FontSize="10" FontWeight="Bold" Foreground="#10B981" />
                        </StackPanel>
                        <SelectableTextBlock Text="{Binding AnswerText}" FontSize="12" TextWrapping="Wrap"
                                             Foreground="#CBD5E1" LineHeight="18" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock IsVisible="{Binding !SelectedEntry.HasRounds}" FontSize="11" Foreground="#64748B"
                       TextWrapping="Wrap"
                       Text="本条记录未保存问答内容（通常发生在打开浏览器阶段被取消或在开始提问前失败）。" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
