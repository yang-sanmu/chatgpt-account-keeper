<UserControl
    x:Class="GptAccountKeeper.Desktop.Presentation.Views.OperationsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GptAccountKeeper.Desktop.Models"
    xmlns:pages="using:GptAccountKeeper.Desktop.Presentation.Pages"
    x:DataType="pages:OperationsPageViewModel">

  <Grid Margin="26,0,26,20" ColumnDefinitions="1.15*,1*" ColumnSpacing="14">

    <Border CornerRadius="10" Background="White" BorderBrush="#EAECF0" BorderThickness="1">
      <Grid RowDefinitions="Auto,*" Margin="14">
        <Grid ColumnDefinitions="*,150,Auto" ColumnSpacing="8" Margin="0,0,0,10">
          <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#475467" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="pages:OperationFilterOption">
                <TextBlock Text="{Binding Title}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="2" Content="重新载入" Padding="10,6" Command="{Binding ReloadCommand}"
                  ToolTip.Tip="任务已持久化，Agent 重启后仍能回看历史失败" />
        </Grid>

        <Panel Grid.Row="1">
          <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:AgentOperationDto">
                <Grid Margin="4,6" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding KindText}" FontWeight="SemiBold" FontSize="12" />
                      <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="#98A2B3" />
                    </StackPanel>
                    <TextBlock Text="{Binding DetailText}" FontSize="10" Foreground="#667085"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding Progress}"
                                 IsVisible="{Binding HasProgress}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold"
                             Foreground="{Binding StateColor}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Spacing="8" MaxWidth="330">
            <TextBlock Text="▶" FontSize="32" Foreground="#D0D5DD" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" TextAlignment="Center"
                       FontSize="12" Foreground="#667085" />
          </StackPanel>
        </Panel>
      </Grid>
    </Border>

    <Border Grid.Column="1" CornerRadius="10" Background="White" BorderBrush="#EAECF0" BorderThickness="1">
      <ScrollViewer Padding="16">
        <StackPanel Spacing="10" IsVisible="{Binding HasSelected}">
          <TextBlock Text="任务详情" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Selected.KindText}" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Selected.StateText}" FontSize="14" FontWeight="SemiBold"
                     Foreground="{Binding Selected.StateColor}" />
          <ProgressBar Minimum="0" Maximum="1" Height="7" Value="{Binding Selected.Progress}" />

          <TextBlock Text="阶段" FontSize="10" Foreground="#667085" />
          <TextBlock Text="{Binding Selected.Stage}" FontSize="12" />
          <TextBlock Text="消息" FontSize="10" Foreground="#667085" />
          <SelectableTextBlock Text="{Binding Selected.Message}" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="资源" FontSize="10" Foreground="#667085" />
          <SelectableTextBlock Text="{Binding Selected.ResourceId}" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="任务 ID" FontSize="10" Foreground="#667085" />
          <SelectableTextBlock Text="{Binding Selected.Id}" FontSize="11" TextWrapping="Wrap"
                               Foreground="#667085" />

          <Border IsVisible="{Binding Selected.HasError}" Padding="12" CornerRadius="8"
                  Background="#FEF3F2" BorderBrush="#FECDCA" BorderThickness="1">
            <StackPanel Spacing="6">
              <TextBlock Text="错误详情" FontSize="12" FontWeight="SemiBold" Foreground="#B42318" />
              <SelectableTextBlock Text="{Binding Selected.Error.Code}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#B42318" />
              <SelectableTextBlock Text="{Binding Selected.Error.Message}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="#7A271A" />
              <Button Content="复制错误详情" Padding="9,5" FontSize="11" HorizontalAlignment="Left"
                      Command="{Binding CopyErrorCommand}" />
            </StackPanel>
          </Border>

          <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#667085"
                     Text="任务写入 SQLite：重连、Agent 重启后错误码和结果仍可查询。上次运行未结束的任务会被标记为已取消，不会伪装成仍在运行。" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
