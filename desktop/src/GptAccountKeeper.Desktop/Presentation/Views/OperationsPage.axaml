<UserControl
    x:Class="GptAccountKeeper.Desktop.Presentation.Views.OperationsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GptAccountKeeper.Desktop.Models"
    xmlns:pages="using:GptAccountKeeper.Desktop.Presentation.Pages"
    x:DataType="pages:OperationsPageViewModel">

  <Grid Margin="24,0,24,20" ColumnDefinitions="1.2*,1*" ColumnSpacing="16">

    <!-- 左侧：任务列表 -->
    <Border Classes="card" Padding="18">
      <Grid RowDefinitions="Auto,*">
        <!-- 头部筛选与刷新 -->
        <Grid ColumnDefinitions="*,140,Auto" ColumnSpacing="12" Margin="0,0,0,14">
          <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="pages:OperationFilterOption">
                <TextBlock Text="{Binding Title}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="2" Content="🔄 刷新" Padding="10,5" FontSize="11" Command="{Binding ReloadCommand}"
                  ToolTip.Tip="任务已持久化到 SQLite，Agent 重启后仍可回看历史记录" />
        </Grid>

        <!-- 任务列表容器 -->
        <Panel Grid.Row="1">
          <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:AgentOperationDto">
                <Border Margin="0,2" Padding="14,11" CornerRadius="10" Background="#0F172A" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                    <StackPanel Spacing="4">
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding KindText}" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" />
                        <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Text="{Binding DetailText}" FontSize="11" Foreground="#94A3B8"
                                 TextTrimming="CharacterEllipsis" />
                      <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding Progress}"
                                   IsVisible="{Binding HasProgress}" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- 状态胶囊 -->
                    <Border Grid.Column="1" Padding="10,4" CornerRadius="6" Background="#080C14"
                            BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{Binding StateColor}" />
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- 空列表提示 -->
          <StackPanel IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Spacing="12" MaxWidth="340">
            <Border Width="64" Height="64" CornerRadius="32" Background="#1E293B" HorizontalAlignment="Center">
              <Path Data="{StaticResource IconActivity}" Width="26" Height="26" Classes="vector-icon" Stroke="#818CF8" />
            </Border>
            <TextBlock Text="暂无后台任务" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" TextAlignment="Center"
                       FontSize="11" Foreground="#94A3B8" LineHeight="17" />
          </StackPanel>
        </Panel>
      </Grid>
    </Border>

    <!-- 右侧：任务详情卡片 -->
    <Border Grid.Column="1" Classes="card" Padding="22">
      <ScrollViewer>
        <StackPanel Spacing="14" IsVisible="{Binding HasSelected}">
          <TextBlock Text="任务详情" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" />

          <Border Padding="16" CornerRadius="10" Background="#0F172A" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Selected.KindText}" FontSize="16" FontWeight="Bold" Foreground="#93C5FD" />
                <Border Grid.Column="1" Padding="10,4" CornerRadius="6" Background="#080C14" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
                  <TextBlock Text="{Binding Selected.StateText}" FontSize="12" FontWeight="SemiBold"
                             Foreground="{Binding Selected.StateColor}" />
                </Border>
              </Grid>
              <ProgressBar Minimum="0" Maximum="1" Height="6" Value="{Binding Selected.Progress}" />
            </StackPanel>
          </Border>

          <StackPanel Spacing="4">
            <TextBlock Text="当前执行阶段" FontSize="10" Foreground="#64748B" />
            <Border Padding="10,6" CornerRadius="6" Background="#0A101D" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
              <TextBlock Text="{Binding Selected.Stage}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" />
            </Border>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="状态消息" FontSize="10" Foreground="#64748B" />
            <Border Padding="10,8" CornerRadius="6" Background="#0A101D" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
              <SelectableTextBlock Text="{Binding Selected.Message}" FontSize="12" TextWrapping="Wrap" Foreground="#CBD5E1" LineHeight="17" />
            </Border>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="关联资源" FontSize="10" Foreground="#64748B" />
            <Border Padding="10,6" CornerRadius="6" Background="#0A101D" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
              <SelectableTextBlock Text="{Binding Selected.ResourceId}" FontSize="12" TextWrapping="Wrap" Foreground="#93C5FD" />
            </Border>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="任务唯一 ID" FontSize="10" Foreground="#64748B" />
            <Border Padding="10,6" CornerRadius="6" Background="#0A101D" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
              <SelectableTextBlock Text="{Binding Selected.Id}" FontSize="10" TextWrapping="Wrap" Foreground="#64748B" FontFamily="Consolas, monospace" />
            </Border>
          </StackPanel>

          <!-- 失败错误详情面板 -->
          <Border IsVisible="{Binding Selected.HasError}" Padding="16" CornerRadius="10"
                  Background="#381014" BorderBrush="#DC2626" BorderThickness="1">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="{StaticResource IconAlertTriangle}" Width="16" Height="16" Classes="vector-icon" Stroke="#F87171" />
                <TextBlock Text="失败错误详情" FontSize="12" FontWeight="Bold" Foreground="#FCA5A5" />
              </StackPanel>
              <SelectableTextBlock Text="{Binding Selected.Error.Code}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#F87171" FontFamily="Consolas, monospace" />
              <SelectableTextBlock Text="{Binding Selected.Error.Message}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="#FECACA" LineHeight="17" />
              <Button Content="📋 复制错误详情" Classes="danger" Padding="10,5" FontSize="11" HorizontalAlignment="Left"
                      Command="{Binding CopyErrorCommand}" Margin="0,4,0,0" />
            </StackPanel>
          </Border>

          <Border Padding="14,12" CornerRadius="8" Background="#0A101D" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#94A3B8" LineHeight="17"
                       Text="💡 任务状态持久化存储于 SQLite：网络断开重连或 Agent 重启后错误码与日志依然可完整回溯。异常终止的任务会被自动收尾标记为已取消。" />
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
