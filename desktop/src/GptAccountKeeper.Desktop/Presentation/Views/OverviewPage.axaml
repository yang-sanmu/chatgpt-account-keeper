<UserControl
    x:Class="GptAccountKeeper.Desktop.Presentation.Views.OverviewPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GptAccountKeeper.Desktop.Models"
    xmlns:pages="using:GptAccountKeeper.Desktop.Presentation.Pages"
    x:DataType="pages:OverviewPageViewModel">

  <ScrollViewer Padding="0,0,0,24">
    <StackPanel Margin="24,0,24,24" Spacing="18">

      <!-- 首次启动引导 Hero Card (仅在需要时显示) -->
      <Border IsVisible="{Binding NeedsFirstRun}"
              Classes="card"
              Background="{DynamicResource BrushSubtleBg}"
              BorderBrush="{DynamicResource BrushPrimary}"
              Padding="22">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Data="{StaticResource IconSparkles}" Width="20" Height="20" Classes="vector-icon"
                      Stroke="{DynamicResource BrushPrimary}" />
                <TextBlock Text="首次启动：创建新数据或导入旧版项目" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" LineHeight="18" Margin="28,0,0,0"
                         Text="导入时请选择旧项目根目录；如果选择 profiles 文件夹，程序会自动识别其父目录。预检完成后会展示账号数量、Profile 大小、运行锁检测与所需磁盘空间，确认后安全复制。" />
            </StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="28,4,0,0">
            <Button Content="📥 预览并导入旧项目" Classes="primary" Command="{Binding ImportLegacyCommand}" />
            <Button Content="✨ 创建全新数据" Command="{Binding CreateFreshDataCommand}" />
            <Button Content="📂 选择其他数据目录" Command="{Binding ChooseDataDirectoryCommand}" />
          </StackPanel>
          <ProgressBar Minimum="0" Maximum="1" Value="{Binding MigrationProgress}" Height="6" Margin="28,6,0,0" />
          <TextBlock Text="{Binding MigrationStage}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="28,0,0,0" />
        </StackPanel>
      </Border>

      <!-- 4 大核心看板指标 (Stats Overview Grid) -->
      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">

        <!-- 卡片 1: 总账号 -->
        <Border Classes="stat-card" Padding="20,18">
          <Grid ColumnDefinitions="48,*" ColumnSpacing="14" VerticalAlignment="Center">
            <!-- 图标容器 -->
            <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource BrushStatCard1Bg}">
              <Path Data="{StaticResource IconUsers}" Width="22" Height="22" Classes="vector-icon"
                    Stroke="{DynamicResource BrushPrimary}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="总账号数" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" />
              <TextBlock Text="{Binding AccountCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
              <TextBlock FontSize="11" Foreground="{DynamicResource BrushPrimary}">
                <Run Text="{Binding EnabledCount}" /><Run Text=" 个参与调度" />
              </TextBlock>
            </StackPanel>
          </Grid>
        </Border>

        <!-- 卡片 2: 已登录在线 -->
        <Border Grid.Column="1" Classes="stat-card" Padding="20,18">
          <Grid ColumnDefinitions="48,*" ColumnSpacing="14" VerticalAlignment="Center">
            <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource BrushStatCard2Bg}">
              <Path Data="{StaticResource IconCheckCircle}" Width="22" Height="22" Classes="vector-icon"
                    Stroke="{DynamicResource BrushSuccess}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="已登录在线" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" />
              <TextBlock Text="{Binding LoggedInCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource BrushSuccess}" />
              <TextBlock FontSize="11" Foreground="{DynamicResource BrushWarning}" IsVisible="{Binding HasNeedsReauth}">
                <Run Text="{Binding NeedsReauthCount}" /><Run Text=" 个需重新登录" />
              </TextBlock>
              <TextBlock FontSize="11" Foreground="{DynamicResource BrushTextMuted}" IsVisible="{Binding !HasNeedsReauth}" Text="所有会话正常" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- 卡片 3: 打开的 Chrome 窗口 -->
        <Border Grid.Column="2" Classes="stat-card" Padding="20,18">
          <Grid ColumnDefinitions="48,*" ColumnSpacing="14" VerticalAlignment="Center">
            <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource BrushStatCard3Bg}">
              <Path Data="{StaticResource IconGlobe}" Width="22" Height="22" Classes="vector-icon"
                    Stroke="{DynamicResource BrushIndigo}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="打开的 Chrome" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" />
              <TextBlock Text="{Binding OpenPageCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource BrushIndigo}" />
              <TextBlock Text="运行中的浏览器窗口" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- 卡片 4: 正在进行的任务 -->
        <Border Grid.Column="3" Classes="stat-card" Padding="20,18">
          <Grid ColumnDefinitions="48,*" ColumnSpacing="14" VerticalAlignment="Center">
            <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource BrushStatCard4Bg}">
              <Path Data="{StaticResource IconActivity}" Width="22" Height="22" Classes="vector-icon"
                    Stroke="{DynamicResource BrushPurple}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="进行中的任务" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" />
              <TextBlock Text="{Binding ActiveOperationCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource BrushPurple}" />
              <TextBlock Text="多阶段任务正在执行" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- 队列与 Chrome 诊断：定位卡顿所必需的最小状态 (计划 §15) -->
      <Border Classes="card" Padding="22">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock Text="后台队列与 Chrome 用量" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
              <TextBlock Text="进行中的任务为 0 时，仍存在的 Chrome 一定能在下面的明细里找到对应记录"
                         FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
            </StackPanel>
            <Button Grid.Column="1" Content="🔄 刷新" Padding="10,5" FontSize="11" Command="{Binding RefreshRunsCommand}" />
          </Grid>

          <!-- 队列计数与槽位用量 -->
          <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
            <StackPanel Spacing="3">
              <TextBlock Text="排队中" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
              <TextBlock Text="{Binding QueuedCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock Text="运行中" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
              <TextBlock Text="{Binding RunningCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="3">
              <TextBlock Text="关闭中" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
              <TextBlock Text="{Binding ClosingCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushWarning}" />
            </StackPanel>
            <StackPanel Grid.Column="3" Spacing="3">
              <TextBlock Text="工作槽" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
              <TextBlock Text="{Binding WorkSlotUsage}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
            </StackPanel>
            <StackPanel Grid.Column="4" Spacing="3">
              <TextBlock Text="Chrome 用量" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
              <TextBlock Text="{Binding ChromeUsage}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushIndigo}" />
              <!-- 长期页面单列：它计入 Chrome 分母，但不是后台任务。 -->
              <TextBlock FontSize="10" Foreground="{DynamicResource BrushTextMuted}">
                <Run Text="含长期页面 " /><Run Text="{Binding LongLivedPageCount}" /><Run Text=" 个" />
              </TextBlock>
            </StackPanel>
          </Grid>

          <!-- 等待阶段：等工作槽 / 等账号锁 / 等 Chrome 槽 -->
          <Border Padding="12,10" CornerRadius="8"
                  Background="{DynamicResource BrushSubtleBg}"
                  BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
              <TextBlock FontSize="11" Foreground="{DynamicResource BrushTextSecondary}">
                <Run Text="等工作槽 " /><Run Text="{Binding WaitingWorkSlotCount}" />
              </TextBlock>
              <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}">
                <Run Text="等账号锁 " /><Run Text="{Binding WaitingAccountCount}" />
              </TextBlock>
              <TextBlock Grid.Column="2" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}">
                <Run Text="等 Chrome 槽 " /><Run Text="{Binding WaitingChromeCount}" />
              </TextBlock>
            </Grid>
          </Border>

          <!-- broker 健康：Agent 级基础设施，不按 BrowserRun 重复列进程 -->
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                     Fill="{DynamicResource BrushSuccess}" IsVisible="{Binding BrokerRunning}" />
            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                     Fill="{DynamicResource BrushDanger}" IsVisible="{Binding !BrokerRunning}" />
            <TextBlock Text="{Binding BrokerStatusText}" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
          </StackPanel>

          <!-- 账号隔离：解除隔离前不接受新操作 -->
          <Border IsVisible="{Binding HasQuarantined}" Padding="14,12" CornerRadius="8" Classes="danger-card">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="{StaticResource IconAlertTriangle}" Width="14" Height="14" Classes="vector-icon"
                      Stroke="{DynamicResource BrushDanger}" />
                <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushDangerText}">
                  <Run Text="{Binding QuarantinedCount}" /><Run Text=" 个账号已隔离：Chrome 未能回收" />
                </TextBlock>
              </StackPanel>
              <TextBlock TextWrapping="Wrap" FontSize="11" LineHeight="17"
                         Foreground="{DynamicResource BrushDangerTextMuted}"
                         Text="这些账号在解除隔离前不接受新操作，对应的 Chrome 仍计入用量分母。可在下面的明细中对具体 run 重试回收。" />
              <ItemsControl ItemsSource="{Binding QuarantinedAccounts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:QuarantinedAccountDto">
                    <TextBlock FontSize="11" Foreground="{DynamicResource BrushDangerTextMuted}" FontFamily="Consolas, monospace">
                      <Run Text="{Binding AccountId}" /><Run Text=" · " /><Run Text="{Binding Reason}" />
                    </TextBlock>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- 活动 Chrome 明细 -->
          <StackPanel Spacing="6">
            <TextBlock Text="活动 Chrome 明细" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" />
            <ItemsControl ItemsSource="{Binding ActiveRuns}" IsVisible="{Binding HasActiveRuns}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pages:BrowserRunRowViewModel">
                  <Border Margin="0,2" Padding="12,10" CornerRadius="8"
                          Background="{DynamicResource BrushCardInner}"
                          BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                      <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding AccountId}" FontSize="12" FontWeight="SemiBold"
                                     Foreground="{DynamicResource BrushTextPrimary}" />
                          <TextBlock Text="{Binding PurposeText}" FontSize="11" VerticalAlignment="Center"
                                     Foreground="{DynamicResource BrushPrimary}" />
                          <TextBlock Text="{Binding SourceText}" FontSize="10" VerticalAlignment="Center"
                                     Foreground="{DynamicResource BrushTextMuted}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <TextBlock Text="{Binding RootPidText}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}"
                                     FontFamily="Consolas, monospace" />
                          <TextBlock Text="{Binding RuntimeText}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DetailText}" FontSize="10" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                      </StackPanel>
                      <Border Grid.Column="1" Padding="9,4" CornerRadius="6" VerticalAlignment="Center"
                              Background="{DynamicResource BrushSubtleBg}"
                              BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
                        <TextBlock Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{Binding StateColor}" />
                      </Border>
                      <!-- 按 run 精确关闭；close_failed 时语义是复验，不是从列表删掉 -->
                      <Button Grid.Column="2" Content="{Binding CloseButtonText}" Padding="10,5" FontSize="11"
                              VerticalAlignment="Center" Command="{Binding CloseCommand}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock IsVisible="{Binding !HasActiveRuns}" Text="{Binding ChromeDetailEmptyText}"
                       FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 双栏控制区 -->
      <Grid ColumnDefinitions="1*,1*" ColumnSpacing="16">

        <!-- 左栏：自动调度与连接状态 -->
        <StackPanel Spacing="16">
          <!-- 自动调度控制中心 -->
          <Border Classes="card" Padding="22">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                  <TextBlock Text="自动调度控制中心" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                  <TextBlock Text="后台按设定的时间间隔轮换对话与状态巡检" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                </StackPanel>
                <Border Grid.Column="1" Padding="12,5" CornerRadius="16"
                        Background="{DynamicResource BrushSubtleBg}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{Binding SchedulerStatusColor}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SchedulerStatusText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{Binding SchedulerStatusColor}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>

              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="▶ 启动自动调度" Classes="primary" Command="{Binding StartSchedulerCommand}" />
                <Button Content="⏹ 停止调度" Command="{Binding StopSchedulerCommand}" />
              </StackPanel>

              <Border Padding="14,12" CornerRadius="8"
                      Background="{DynamicResource BrushSubtleBg}"
                      BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
                <StackPanel Spacing="4">
                  <TextBlock Text="💡 托盘常驻与风控保护" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimary}" />
                  <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" LineHeight="17"
                             Text="最小化到系统托盘后，自动对话与 Session 巡检依然由本地独立 Agent 持续执行。各账号会叠加随机抖动以防止被识别为机器人行为。" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Agent 守护进程状态 -->
          <Border Classes="card" Padding="22">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Agent 守护进程状态" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                <Border Grid.Column="1" Padding="8,3" CornerRadius="12"
                        Background="{DynamicResource BrushSubtleBg}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                  <TextBlock Text="{Binding ConnectionStatus}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimary}" />
                </Border>
              </Grid>
              <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
                <StackPanel Spacing="3">
                  <TextBlock Text="Agent 版本" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                  <TextBlock Text="{Binding AgentVersion}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="实例标识" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                  <TextBlock Text="{Binding InstanceId}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                  <TextBlock Text="最近事件" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                  <TextBlock Text="{Binding LastEvent}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                </StackPanel>
              </Grid>
              <TextBlock Text="{Binding ConnectionDetail}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 右栏：数据位置与系统诊断 -->
        <Border Grid.Column="1" Classes="card" Padding="22">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="数据与系统诊断" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
              <Border Grid.Column="1" Padding="6,2" CornerRadius="4" Background="{DynamicResource BrushBadgeBg}">
                <TextBlock Text="{Binding RuntimeMode}" FontSize="10" Foreground="{DynamicResource BrushInfo}" />
              </Border>
            </Grid>

            <StackPanel Spacing="5">
              <TextBlock Text="数据存储目录" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" />
              <Border Padding="10,8" CornerRadius="8"
                      Background="{DynamicResource BrushCardInner}"
                      BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
                <SelectableTextBlock Text="{Binding DataDirectory}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" FontFamily="Consolas, monospace" />
              </Border>
            </StackPanel>

            <StackPanel Spacing="5">
              <TextBlock Text="Agent 运行日志" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" />
              <Border Padding="10,8" CornerRadius="8"
                      Background="{DynamicResource BrushCardInner}"
                      BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
                <SelectableTextBlock Text="{Binding AgentLogFile}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" FontFamily="Consolas, monospace" />
              </Border>
            </StackPanel>

            <Border Padding="14,12" CornerRadius="8"
                    Background="{DynamicResource BrushSubtleBg}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
              <StackPanel Spacing="4">
                <TextBlock Text="⚙ 快捷管理建议" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimary}" />
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" LineHeight="17"
                           Text="在「设置」页面中可以直接一键打开数据或日志文件夹，或者复制完整路径用于故障排查与备份。" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
