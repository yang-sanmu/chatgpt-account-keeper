<UserControl
    x:Class="GptAccountKeeper.Desktop.Presentation.Views.ProfilesPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GptAccountKeeper.Desktop.Models"
    xmlns:pages="using:GptAccountKeeper.Desktop.Presentation.Pages"
    x:DataType="pages:ProfilesPageViewModel">

  <Grid Margin="24,0,24,20" ColumnDefinitions="1.35*,1*" ColumnSpacing="16">

    <!-- 左侧：Profile 列表与扫描工具 -->
    <Border Classes="card" Padding="16">
      <Grid RowDefinitions="Auto,*">
        <StackPanel Spacing="10" Margin="0,0,0,12">
          <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#93C5FD" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="🔍 重新扫描" Classes="primary" Padding="10,5" FontSize="11" Command="{Binding ScanCommand}" />
            <Button Content="🧹 清理全部可重建缓存" Padding="10,5" FontSize="11" Command="{Binding CleanAllCommand}" />
            <CheckBox Content="只看孤儿 Profile" IsChecked="{Binding OnlyOrphans, Mode=TwoWay}"
                      VerticalAlignment="Center" Margin="6,0,0,0" />
          </StackPanel>
        </StackPanel>

        <Panel Grid.Row="1">
          <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:ProfileEntryDto">
                <Border Margin="0,2" Padding="12,10" CornerRadius="8" Background="#0F172A" BorderBrush="#1E2D4A" BorderThickness="1">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#F8FAFC" />
                      <TextBlock Text="{Binding SizeText}" FontSize="10" Foreground="#94A3B8" />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="8,3" CornerRadius="6" Background="#1E293B" VerticalAlignment="Center">
                      <TextBlock Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold" Foreground="#60A5FA" />
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- 空列表提示 -->
          <StackPanel IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Spacing="8" MaxWidth="330">
            <TextBlock Text="📁" FontSize="30" HorizontalAlignment="Center" />
            <TextBlock Text="暂无 Profile 数据" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Foreground="#94A3B8" LineHeight="16"
                       Text="{Binding EmptyText}" />
          </StackPanel>
        </Panel>
      </Grid>
    </Border>

    <!-- 右侧：所选 Profile 操作与安全说明 -->
    <Border Grid.Column="1" Classes="card" Padding="20">
      <ScrollViewer>
        <StackPanel Spacing="14" IsVisible="{Binding HasSelected}">
          <TextBlock Text="所选 Profile 详情" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" />

          <Border Padding="14" CornerRadius="10" Background="#0F172A" BorderBrush="#1E2D4A" BorderThickness="1">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding Selected.Name}" FontSize="16" FontWeight="Bold" Foreground="#93C5FD" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                <StackPanel Spacing="2">
                  <TextBlock Text="状态" FontSize="10" Foreground="#64748B" />
                  <TextBlock Text="{Binding Selected.StateText}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="磁盘占用" FontSize="10" Foreground="#64748B" />
                  <TextBlock Text="{Binding Selected.SizeText}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- 孤儿状态提示 -->
          <Border Padding="10" CornerRadius="8" Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
            <TextBlock Text="{Binding OrphanHint}" FontSize="11" Foreground="#FCD34D" TextWrapping="Wrap" />
          </Border>

          <StackPanel Spacing="8">
            <Button Content="🧹 清理所选缓存 (安全)" HorizontalAlignment="Stretch" Padding="12,7"
                    Command="{Binding CleanSelectedCommand}" />
            <Button Content="📦 归档孤儿 Profile…" HorizontalAlignment="Stretch" Padding="12,7"
                    IsEnabled="{Binding CanOperateOrphan}" Command="{Binding ArchiveOrphanCommand}" />
            <Button Content="🗑 永久删除孤儿 Profile…" Classes="danger" HorizontalAlignment="Stretch" Padding="12,7"
                    IsEnabled="{Binding CanOperateOrphan}" Command="{Binding PurgeOrphanCommand}" />
          </StackPanel>

          <!-- 安全指引说明 -->
          <Border Padding="12" Background="#0F172A" BorderBrush="#1E2D4A" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="4">
              <TextBlock Text="🛡️ 缓存与存储安全保障" FontSize="11" FontWeight="SemiBold" Foreground="#93C5FD" />
              <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#94A3B8" LineHeight="16"
                         Text="缓存清理只删可安全重建的网页、代码与 GPU 缓存，完全保留 Cookie、Local Storage 与 IndexedDB，登录态不受影响。永久删除会二次确认；关联账号或正在运行中的 Profile 受写保护不可删除。" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
