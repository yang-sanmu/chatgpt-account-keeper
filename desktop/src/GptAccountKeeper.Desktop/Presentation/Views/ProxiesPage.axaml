<UserControl
    x:Class="GptAccountKeeper.Desktop.Presentation.Views.ProxiesPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GptAccountKeeper.Desktop.Models"
    xmlns:vm="using:GptAccountKeeper.Desktop.Presentation"
    xmlns:pages="using:GptAccountKeeper.Desktop.Presentation.Pages"
    x:DataType="pages:ProxiesPageViewModel">

  <Grid Margin="24,0,24,20" ColumnDefinitions="360,*" ColumnSpacing="16">

    <!-- 左侧：账号分组管理与路由出口绑定 -->
    <Grid RowDefinitions="*,Auto" RowSpacing="14">

      <!-- 分组列表卡片 -->
      <Border Classes="card" Padding="18">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <StackPanel Spacing="3">
              <TextBlock Text="账号分组 (定向出口)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
              <TextBlock Text="{Binding GroupSummary}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
            </StackPanel>
            <Button Grid.Column="1" Content="➕ 新建分组" Classes="primary" Padding="10,5" FontSize="11"
                    Command="{Binding BeginNewGroupCommand}" />
          </Grid>

          <!-- 分组列表 -->
          <Panel Grid.Row="1">
            <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:GroupDto">
                  <Border Margin="0,2" Padding="14,10" CornerRadius="8"
                          Background="{DynamicResource BrushCardInner}"
                          BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" />
                        <TextBlock Text="{Binding SummaryText}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="›" FontSize="16" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空状态 -->
            <StackPanel IsVisible="{Binding !HasGroups}" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="10" MaxWidth="280">
              <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource BrushBadgeBg}" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconTag}" Width="24" Height="24" Classes="vector-icon"
                      Stroke="{DynamicResource BrushPrimary}" />
              </Border>
              <TextBlock Text="还没有账号分组" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" />
              <TextBlock Text="点击右上角“新建分组”为账号绑定特定国家的网络出口节点。"
                         TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" LineHeight="16" />
            </StackPanel>
          </Panel>
        </Grid>
      </Border>

      <!-- 分组详情与编辑表单卡片 -->
      <Border Grid.Row="1" Classes="card" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding GroupFormTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />

          <StackPanel Spacing="3">
            <TextBlock Text="分组名称" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
            <TextBox PlaceholderText="如：美国住宅组、香港备用" Text="{Binding GroupName, Mode=TwoWay}"
                     IsEnabled="{Binding CanEditGroup}" />
          </StackPanel>

          <StackPanel Spacing="3">
            <TextBlock Text="绑定网络出口节点" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ProxyChoices}"
                      SelectedItem="{Binding GroupProxy, Mode=TwoWay}"
                      IsEnabled="{Binding CanEditGroup}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RouteChoiceViewModel">
                  <TextBlock Text="{Binding Title}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <StackPanel Spacing="3">
              <TextBlock Text="时区 (留空自动)" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
              <TextBox PlaceholderText="America/New_York" Text="{Binding GroupTimezone, Mode=TwoWay}"
                       IsEnabled="{Binding CanEditGroup}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="3">
              <TextBlock Text="Locale (语言区域)" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
              <TextBox PlaceholderText="en-US" Text="{Binding GroupLocale, Mode=TwoWay}"
                       IsEnabled="{Binding CanEditGroup}" />
            </StackPanel>
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
            <Button Content="{Binding GroupSaveText}" Classes="primary"
                    IsEnabled="{Binding CanEditGroup}" Command="{Binding SaveGroupCommand}" />
            <Button Content="删除分组" Classes="danger" Command="{Binding RemoveGroupCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- 右侧：Clash 订阅与代理节点 -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="14">

      <!-- 订阅与内核配置卡片 -->
      <Border Classes="card" Padding="18">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding SubscriptionSummary}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimary}" />
              <TextBlock Text="{Binding RuntimeSummary}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <TextBox PlaceholderText="输入 Clash / Mihomo 订阅地址 (不回显)…"
                     Text="{Binding SubscriptionUrl, Mode=TwoWay}" PasswordChar="•" />
            <Button Grid.Column="1" Content="📥 导入订阅" Classes="primary" Command="{Binding ImportSubscriptionCommand}" />
            <Button Grid.Column="2" Content="🔄 刷新订阅" Command="{Binding RefreshSubscriptionCommand}" />
          </Grid>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBox PlaceholderText="Clash Verge / mihomo 安装目录（包含 mihomo.exe）"
                     Text="{Binding RuntimeDirectory, Mode=TwoWay}" />
            <Button Grid.Column="1" Content="保存内核目录" Command="{Binding SaveRuntimeDirectoryCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- 节点列表卡片 -->
      <Border Grid.Row="1" Classes="card" Padding="18">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,280" ColumnSpacing="12" Margin="0,0,0,14">
            <TextBlock Text="{Binding NodeSummary}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" PlaceholderText="🔍 搜索节点名、协议或服务器…"
                     Text="{Binding NodeSearch, Mode=TwoWay}" />
          </Grid>

          <Panel Grid.Row="1">
            <ListBox ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:ProxyNodeDto">
                  <Border Margin="0,2" Padding="14,9" CornerRadius="8"
                          Background="{DynamicResource BrushCardInner}"
                          BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
                    <Grid ColumnDefinitions="*,75,115,100,75" ColumnSpacing="8" VerticalAlignment="Center">
                      <!-- 节点名与服务器 -->
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ServerText}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" FontFamily="Consolas, monospace" />
                      </StackPanel>

                      <!-- 协议类型徽章 -->
                      <Border Grid.Column="1" Padding="7,2" CornerRadius="4" Background="{DynamicResource BrushBadgeBg}" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimary}" />
                      </Border>

                      <!-- 本地端口 -->
                      <TextBlock Grid.Column="2" Text="{Binding LocalPortText}" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"
                                 VerticalAlignment="Center" FontFamily="Consolas, monospace" />

                      <!-- 延迟标签 (色彩阶梯) -->
                      <Border Grid.Column="3" Padding="8,3" CornerRadius="6" Background="{DynamicResource BrushSubtleBg}" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LatencyText}" FontSize="11" FontWeight="Bold"
                                   Foreground="{Binding LatencyColor}"
                                   ToolTip.Tip="{Binding LatencyTooltip}" />
                      </Border>

                      <!-- 状态指示灯 -->
                      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{Binding StateColor}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{Binding StateColor}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空列表提示 -->
            <StackPanel IsVisible="{Binding IsNodeListEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="12" MaxWidth="380">
              <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource BrushBadgeBg}" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconGlobe}" Width="28" Height="28" Classes="vector-icon"
                      Stroke="{DynamicResource BrushPrimary}" />
              </Border>
              <TextBlock Text="暂无匹配代理节点" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" />
              <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" LineHeight="17"
                         Text="{Binding NodeEmptyText}" />
            </StackPanel>
          </Panel>
        </Grid>
      </Border>

      <!-- 底部节点工具栏 -->
      <Border Grid.Row="2" Classes="card" Padding="16,12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"
                     Text="💡 测速使用独立临时 mihomo 进程，不打断账号正常连接。批量测速会逐个回填延迟数据。" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
            <Button Content="⚡ 测速所选" Padding="12,6" FontSize="11" Command="{Binding TestNodeCommand}" />
            <Button Content="🚀 全部测速" Classes="primary" Padding="12,6" FontSize="11" Command="{Binding TestAllCommand}" />
            <Button Content="{Binding ToggleNodeText}" Padding="12,6" FontSize="11"
                    Command="{Binding ToggleNodeCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
