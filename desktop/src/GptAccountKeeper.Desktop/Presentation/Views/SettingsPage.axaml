<UserControl
    x:Class="GptAccountKeeper.Desktop.Presentation.Views.SettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GptAccountKeeper.Desktop.Presentation"
    xmlns:pages="using:GptAccountKeeper.Desktop.Presentation.Pages"
    x:DataType="pages:SettingsPageViewModel">

  <ScrollViewer Padding="0,0,0,24">
    <Grid Margin="24,0,24,24" ColumnDefinitions="1*,1*" ColumnSpacing="16">

      <!-- 左栏：调度风控与诊断 -->
      <StackPanel Spacing="16">

        <!-- 调度与风控参数卡片 -->
        <Border Classes="card" Padding="22">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock Text="定时调度与风控防封参数" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                <TextBlock Text="调控对话轮换频率与随机抖动防风控" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding PendingEditText}" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource BrushWarning}" VerticalAlignment="Center" />
            </Grid>

            <!-- 间隔与抖动 -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="每轮轮换基础间隔 (分钟)" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" />
                <NumericUpDown Minimum="1" Maximum="10080" Increment="10" FormatString="0"
                               Value="{Binding IntervalMinutes, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="随机抖动浮动 (分钟)" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" />
                <NumericUpDown Minimum="0" Maximum="1440" Increment="5" FormatString="0"
                               Value="{Binding JitterMinutes, Mode=TwoWay}" />
              </StackPanel>
            </Grid>

            <!-- 巡检与网页兜底 -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="登录状态巡检间隔 (分钟)" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" />
                <NumericUpDown Minimum="1" Maximum="1440" Increment="5" FormatString="0"
                               Value="{Binding StatusCheckMinutes, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="打开网页窗口超时 (0=不限)" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" />
                <NumericUpDown Minimum="0" Maximum="1440" Increment="10" FormatString="0"
                               Value="{Binding OpenPageTimeoutMinutes, Mode=TwoWay}" />
              </StackPanel>
            </Grid>

            <Rectangle Height="1" Fill="{DynamicResource BrushBorderSubtle}" Margin="0,2" />

            <!-- 开关选项 -->
            <CheckBox Content="后台自动化执行使用 Headless 无头模式 (不弹 Chrome 窗)"
                      IsChecked="{Binding Headless, Mode=TwoWay}" />
            <CheckBox Content="Agent 启动后立即对所有账号执行一次登录巡检"
                      IsChecked="{Binding StatusCheckOnStartup, Mode=TwoWay}" />
            <CheckBox Content="自动维护 Profile 缓存 (关闭浏览器后超 128MB 自动清理)"
                      IsChecked="{Binding ProfileAutoCleanEnabled, Mode=TwoWay}" />

            <!-- 校验提示 -->
            <Border IsVisible="{Binding HasValidationError}" Padding="12" Classes="danger-card">
              <TextBlock Text="{Binding ValidationError}" FontSize="11"
                         Foreground="{DynamicResource BrushDangerText}" TextWrapping="Wrap" />
            </Border>

            <!-- 保存与放弃按钮 -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
              <Button Content="💾 保存风控设置" Classes="primary" Command="{Binding SaveAgentSettingsCommand}" />
              <Button Content="放弃修改" Command="{Binding RevertAgentSettingsCommand}" />
            </StackPanel>

            <Border Padding="14,12" Background="{DynamicResource BrushSubtleBg}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8">
              <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" LineHeight="17"
                         Text="💡 建议：基础间隔保持 180 分钟以上，抖动浮动保持 30 分钟以上，以模拟人类真实的不规律上网行为，最大程度避免触发账号风控。" />
            </Border>
          </StackPanel>
        </Border>

        <!-- 数据目录与日志卡片 -->
        <Border Classes="card" Padding="22">
          <StackPanel Spacing="14">
            <TextBlock Text="数据存储与日志诊断" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
            <Border Padding="6,2" CornerRadius="4" Background="{DynamicResource BrushBadgeBg}" HorizontalAlignment="Left">
              <TextBlock Text="{Binding RuntimeMode}" FontSize="10" Foreground="{DynamicResource BrushInfo}" />
            </Border>

            <StackPanel Spacing="4">
              <TextBlock Text="数据目录" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
              <Border Padding="10,8" CornerRadius="8" Background="{DynamicResource BrushCardInner}"
                      BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
                <SelectableTextBlock Text="{Binding DataDirectory}" FontSize="11" TextWrapping="Wrap"
                                     Foreground="{DynamicResource BrushTextPrimary}" FontFamily="Consolas, monospace" />
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <Button Content="📂 打开数据目录" Padding="10,5" FontSize="11" Command="{Binding OpenDataDirectoryCommand}" />
                <Button Content="📋 复制路径" Padding="10,5" FontSize="11" Command="{Binding CopyDataDirectoryCommand}" />
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="4" Margin="0,4,0,0">
              <TextBlock Text="Agent 独立日志" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
              <Border Padding="10,8" CornerRadius="8" Background="{DynamicResource BrushCardInner}"
                      BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
                <SelectableTextBlock Text="{Binding AgentLogFile}" FontSize="11" TextWrapping="Wrap"
                                     Foreground="{DynamicResource BrushTextPrimary}" FontFamily="Consolas, monospace" />
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <Button Content="📂 打开日志位置" Padding="10,5" FontSize="11" Command="{Binding OpenLogFileCommand}" />
                <Button Content="📋 复制日志路径" Padding="10,5" FontSize="11" Command="{Binding CopyLogPathCommand}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 旧项目导入卡片：首次启动之后仍可导入 -->
        <Border Classes="card" Padding="22">
          <StackPanel Spacing="14">
            <TextBlock Text="从旧版本导入 Profile 与账号" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" LineHeight="17"
                       Text="选定目录后会先只读预检扫描；Profile 较大时可能需要一些时间，可随时取消。首次启动自动生成的空数据库可以直接导入；当前库已有业务数据时会引导你改选新的空数据目录。旧项目不会被修改。" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="📥 预览并导入旧项目" Classes="primary" Padding="12,6" FontSize="11"
                      Command="{Binding ImportLegacyCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- 右栏：桌面行为与版本更新 -->
      <StackPanel Grid.Column="1" Spacing="16">

        <!-- 桌面与托盘行为卡片 -->
        <Border Classes="card" Padding="22">
          <StackPanel Spacing="14">
            <TextBlock Text="桌面与系统行为" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />

            <!-- 外观主题切换 -->
            <StackPanel Spacing="4">
              <TextBlock Text="外观主题 (Theme)" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" />
              <ComboBox HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Behavior.ThemeOptions}"
                        SelectedItem="{Binding Behavior.SelectedTheme, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ThemeOptionViewModel">
                    <StackPanel Margin="2" Spacing="2">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" />
                      <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="关闭主窗口时的行为" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" />
              <ComboBox HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Behavior.CloseBehaviorOptions}"
                        SelectedItem="{Binding Behavior.SelectedCloseBehavior, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:CloseBehaviorOptionViewModel">
                    <StackPanel Margin="2" Spacing="2">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" />
                      <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <!-- 应用开机自启与调度自启是两个独立行为。 -->
            <StackPanel Spacing="5">
              <TextBlock Text="启动行为" FontSize="11" FontWeight="Medium"
                         Foreground="{DynamicResource BrushTextSecondary}" />
              <Border Padding="14,12" Classes="subtle-card">
                <StackPanel Spacing="10">
                  <StackPanel Spacing="3">
                    <CheckBox Content="登录系统时自动启动应用"
                              IsChecked="{Binding Behavior.StartAtLogin, Mode=TwoWay}" />
                    <TextBlock Margin="28,0,0,0" Text="以隐藏到托盘方式启动，不主动弹出主窗口。"
                               FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                  </StackPanel>

                  <Rectangle Height="1" Fill="{DynamicResource BrushBorderSubtle}" />

                  <StackPanel Spacing="3">
                    <CheckBox Content="打开应用后自动启动调度"
                              IsChecked="{Binding Behavior.AutoStartScheduler, Mode=TwoWay}" />
                    <TextBlock Margin="28,0,0,0" Text="成功连接 Agent 后启动账号调度；关闭此项仍可随时手动启动。"
                               TextWrapping="Wrap" FontSize="10"
                               Foreground="{DynamicResource BrushTextMuted}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <Border Padding="14,12" Background="{DynamicResource BrushSubtleBg}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8">
              <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" LineHeight="17"
                         Text="桌面端设置写入独立的 desktop.json，不与 Agent 业务数据混写，独立管理。" />
            </Border>
          </StackPanel>
        </Border>

        <!-- 应用升级与排空卡片 -->
        <Border Classes="card" Padding="22">
          <StackPanel Spacing="14">
            <TextBlock Text="应用与内核更新" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />

            <StackPanel Spacing="4">
              <TextBlock Text="自动检查更新策略" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" />
              <ComboBox HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Behavior.UpdatePolicyOptions}"
                        SelectedItem="{Binding Behavior.SelectedUpdatePolicy, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:UpdatePolicyOptionViewModel">
                    <StackPanel Margin="2" Spacing="2">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" />
                      <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <!-- 更新状态 -->
            <Border Padding="12,10" CornerRadius="8" Background="{DynamicResource BrushSubtleBg}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
              <TextBlock Text="{Binding Behavior.UpdateStatus}" TextWrapping="Wrap" FontSize="11"
                         Foreground="{DynamicResource BrushPrimary}" LineHeight="17" />
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="🔍 检查更新" Classes="primary" Padding="12,6" FontSize="11" Command="{Binding Behavior.CheckUpdateCommand}" />
              <Button Content="📥 下载更新" Padding="12,6" FontSize="11" Command="{Binding Behavior.DownloadUpdateCommand}" />
              <Button Content="🚀 安全安装" Padding="12,6" FontSize="11" Command="{Binding Behavior.InstallUpdateCommand}" />
            </StackPanel>

            <Border Padding="14,12" Background="{DynamicResource BrushSubtleBg}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8">
              <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" LineHeight="17"
                         Text="🔒 启动时会立即检查一次更新，之后每 30 分钟后台检查一次；发现新版本会弹窗供选择立即更新、下次启动提醒或忽略本次更新。安装更新前 Agent 必须先安全排空，不会强杀任务。" />
            </Border>
          </StackPanel>
        </Border>

        <!-- 关于、许可与隐私 -->
        <Border Classes="card" Padding="22">
          <StackPanel Spacing="12">
            <TextBlock Text="关于与许可" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
            <TextBlock Text="ChatGPT Account Keeper" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimary}" />
            <TextBlock Text="GNU AGPL-3.0-only · 非官方个人开源项目，与 OpenAI、Google 无隶属或背书关系。"
                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" LineHeight="17" />
            <TextBlock Text="安装包附带项目许可证、第三方组件声明、隐私说明与对应源码说明。安装包未经数字签名，Windows 首次运行可能显示 SmartScreen 提示。"
                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" LineHeight="17" />
            <Button Content="📂 打开许可与政策目录" HorizontalAlignment="Left" Padding="10,5" FontSize="11"
                    Command="{Binding OpenLegalDocumentsCommand}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
