<UserControl
    x:Class="GptAccountKeeper.Desktop.Presentation.Views.SettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GptAccountKeeper.Desktop.Presentation"
    xmlns:pages="using:GptAccountKeeper.Desktop.Presentation.Pages"
    x:DataType="pages:SettingsPageViewModel">

  <ScrollViewer Padding="0,0,0,20">
    <Grid Margin="24,0,24,24" ColumnDefinitions="1*,1*" ColumnSpacing="16">

      <!-- 左栏：调度风控与诊断 -->
      <StackPanel Spacing="16">

        <!-- 调度与风控参数卡片 -->
        <Border Classes="card" Padding="20">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="定时调度与风控防封参数" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" />
                <TextBlock Text="调控对话轮换频率与随机抖动防风控" FontSize="11" Foreground="#94A3B8" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding PendingEditText}" FontSize="11" FontWeight="SemiBold"
                         Foreground="#F59E0B" VerticalAlignment="Center" />
            </Grid>

            <!-- 间隔与抖动 -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="每轮轮换基础间隔 (分钟)" FontSize="11" FontWeight="Medium" Foreground="#94A3B8" />
                <NumericUpDown Minimum="1" Maximum="10080" Increment="10" FormatString="0"
                               Value="{Binding IntervalMinutes, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="随机抖动浮动 (分钟)" FontSize="11" FontWeight="Medium" Foreground="#94A3B8" />
                <NumericUpDown Minimum="0" Maximum="1440" Increment="5" FormatString="0"
                               Value="{Binding JitterMinutes, Mode=TwoWay}" />
              </StackPanel>
            </Grid>

            <!-- 巡检与网页兜底 -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="登录状态巡检间隔 (分钟)" FontSize="11" FontWeight="Medium" Foreground="#94A3B8" />
                <NumericUpDown Minimum="1" Maximum="1440" Increment="5" FormatString="0"
                               Value="{Binding StatusCheckMinutes, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="打开网页窗口超时 (0=不限)" FontSize="11" FontWeight="Medium" Foreground="#94A3B8" />
                <NumericUpDown Minimum="0" Maximum="1440" Increment="10" FormatString="0"
                               Value="{Binding OpenPageTimeoutMinutes, Mode=TwoWay}" />
              </StackPanel>
            </Grid>

            <Rectangle Height="1" Fill="#1E2D4A" Margin="0,4" />

            <!-- 开关选项 -->
            <CheckBox Content="后台自动化执行使用 Headless 无头模式 (不弹 Chrome 窗)"
                      IsChecked="{Binding Headless, Mode=TwoWay}" />
            <CheckBox Content="Agent 启动后立即对所有账号执行一次登录巡检"
                      IsChecked="{Binding StatusCheckOnStartup, Mode=TwoWay}" />
            <CheckBox Content="自动维护 Profile 缓存 (关闭浏览器后超 128MB 自动清理)"
                      IsChecked="{Binding ProfileAutoCleanEnabled, Mode=TwoWay}" />

            <!-- 校验提示 -->
            <Border IsVisible="{Binding HasValidationError}"
                    Padding="10" CornerRadius="8" Background="#450A0A" BorderBrush="#DC2626" BorderThickness="1">
              <TextBlock Text="{Binding ValidationError}" FontSize="11" Foreground="#FCA5A5" TextWrapping="Wrap" />
            </Border>

            <!-- 保存与放弃按钮 -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
              <Button Content="💾 保存风控设置" Classes="primary" Command="{Binding SaveAgentSettingsCommand}" />
              <Button Content="放弃修改" Command="{Binding RevertAgentSettingsCommand}" />
            </StackPanel>

            <Border Padding="12" Background="#0F172A" BorderBrush="#1E2D4A" BorderThickness="1" CornerRadius="8">
              <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#94A3B8" LineHeight="16"
                         Text="💡 间隔时间越短越容易触发 OpenAI 风控。建议保持 30 分钟以上的随机抖动区间，以有效模拟人类不规则上网习惯。" />
            </Border>
          </StackPanel>
        </Border>

        <!-- 数据目录与日志卡片 -->
        <Border Classes="card" Padding="20">
          <StackPanel Spacing="12">
            <TextBlock Text="数据存储与日志诊断" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" />
            <Border Padding="6,2" CornerRadius="4" Background="#1E293B" HorizontalAlignment="Left">
              <TextBlock Text="{Binding RuntimeMode}" FontSize="10" Foreground="#38BDF8" />
            </Border>

            <StackPanel Spacing="4">
              <TextBlock Text="数据目录" FontSize="11" Foreground="#64748B" />
              <Border Padding="10,8" CornerRadius="8" Background="#0A101D" BorderBrush="#1E2D4A" BorderThickness="1">
                <SelectableTextBlock Text="{Binding DataDirectory}" FontSize="11" TextWrapping="Wrap" Foreground="#CBD5E1" />
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                <Button Content="📂 打开数据目录" Padding="10,5" FontSize="11" Command="{Binding OpenDataDirectoryCommand}" />
                <Button Content="📋 复制路径" Padding="10,5" FontSize="11" Command="{Binding CopyDataDirectoryCommand}" />
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="4" Margin="0,4,0,0">
              <TextBlock Text="Agent 独立日志" FontSize="11" Foreground="#64748B" />
              <Border Padding="10,8" CornerRadius="8" Background="#0A101D" BorderBrush="#1E2D4A" BorderThickness="1">
                <SelectableTextBlock Text="{Binding AgentLogFile}" FontSize="11" TextWrapping="Wrap" Foreground="#CBD5E1" />
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                <Button Content="📂 打开日志位置" Padding="10,5" FontSize="11" Command="{Binding OpenLogFileCommand}" />
                <Button Content="📋 复制日志路径" Padding="10,5" FontSize="11" Command="{Binding CopyLogPathCommand}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 旧项目导入卡片：首次启动之后仍可导入 -->
        <Border Classes="card" Padding="20">
          <StackPanel Spacing="12">
            <TextBlock Text="从旧版本导入 Profile 与账号" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" />
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#94A3B8" LineHeight="16"
                       Text="迁移只会写入一个尚未建库的数据目录，所以当前目录已初始化时会先让你选一个新的数据目录，随后自动重启并在那里完成导入。旧项目和当前数据目录都只读不改。" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="📥 预览并导入旧项目" Classes="primary" Padding="12,6" FontSize="11"
                      Command="{Binding ImportLegacyCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- 右栏：桌面行为与版本更新 -->
      <StackPanel Grid.Column="1" Spacing="16">

        <!-- 桌面与托盘行为卡片 -->
        <Border Classes="card" Padding="20">
          <StackPanel Spacing="12">
            <TextBlock Text="桌面与系统行为" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" />

            <StackPanel Spacing="4">
              <TextBlock Text="关闭主窗口时的行为" FontSize="11" FontWeight="Medium" Foreground="#94A3B8" />
              <ComboBox HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Behavior.CloseBehaviorOptions}"
                        SelectedItem="{Binding Behavior.SelectedCloseBehavior, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:CloseBehaviorOptionViewModel">
                    <StackPanel Margin="2" Spacing="1">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="#F8FAFC" />
                      <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#94A3B8" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <CheckBox Content="开机登录系统后自动启动并隐藏到托盘恢复调度"
                      IsChecked="{Binding Behavior.StartAtLogin, Mode=TwoWay}" />

            <Border Padding="12" Background="#0F172A" BorderBrush="#1E2D4A" BorderThickness="1" CornerRadius="8">
              <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#94A3B8" LineHeight="16"
                         Text="桌面端设置写入独立的 desktop.json，不与 Agent 业务数据混写。" />
            </Border>
          </StackPanel>
        </Border>

        <!-- 应用升级与排空卡片 -->
        <Border Classes="card" Padding="20">
          <StackPanel Spacing="12">
            <TextBlock Text="应用与内核更新" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" />

            <StackPanel Spacing="4">
              <TextBlock Text="自动检查更新策略" FontSize="11" FontWeight="Medium" Foreground="#94A3B8" />
              <ComboBox HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Behavior.UpdatePolicyOptions}"
                        SelectedItem="{Binding Behavior.SelectedUpdatePolicy, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:UpdatePolicyOptionViewModel">
                    <StackPanel Margin="2" Spacing="1">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="#F8FAFC" />
                      <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#94A3B8" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <!-- 更新状态 -->
            <Border Padding="10,8" CornerRadius="8" Background="#0F172A" BorderBrush="#1E2D4A" BorderThickness="1">
              <TextBlock Text="{Binding Behavior.UpdateStatus}" TextWrapping="Wrap" FontSize="11"
                         Foreground="#93C5FD" LineHeight="16" />
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="🔍 检查更新" Classes="primary" Padding="12,6" FontSize="11" Command="{Binding Behavior.CheckUpdateCommand}" />
              <Button Content="📥 下载更新" Padding="12,6" FontSize="11" Command="{Binding Behavior.DownloadUpdateCommand}" />
              <Button Content="🚀 安全安装" Padding="12,6" FontSize="11" Command="{Binding Behavior.InstallUpdateCommand}" />
            </StackPanel>

            <Border Padding="12" Background="#0F172A" BorderBrush="#1E2D4A" BorderThickness="1" CornerRadius="8">
              <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#94A3B8" LineHeight="16"
                         Text="🔒 启动时会立即检查一次更新，之后每 6 小时后台检查一次；发现新版本会弹窗供选择立即更新、下次启动提醒或忽略本次更新。安装更新前 Agent 必须先排空：仍有 Chrome 窗口或关键任务时会拒绝安装，调度任务最多等待 60 秒，超时则放弃本次升级并恢复原状态，不会强杀任务。" />
            </Border>
          </StackPanel>
        </Border>

        <!-- 关于、许可与隐私 -->
        <Border Classes="card" Padding="20">
          <StackPanel Spacing="11">
            <TextBlock Text="关于与许可" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" />
            <TextBlock Text="ChatGPT Account Keeper" FontSize="13" FontWeight="SemiBold" Foreground="#93C5FD" />
            <TextBlock Text="GNU AGPL-3.0-only · 非官方个人项目，与 OpenAI、Google 无隶属或背书关系。"
                       TextWrapping="Wrap" FontSize="11" Foreground="#CBD5E1" LineHeight="16" />
            <TextBlock Text="安装包附带项目许可证、第三方组件声明、隐私说明与对应源码说明。安装包未经数字签名，Windows 首次运行可能显示 SmartScreen 提示。"
                       TextWrapping="Wrap" FontSize="11" Foreground="#94A3B8" LineHeight="16" />
            <Button Content="📂 打开许可与政策目录" HorizontalAlignment="Left" Padding="10,5" FontSize="11"
                    Command="{Binding OpenLegalDocumentsCommand}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
